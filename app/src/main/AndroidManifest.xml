<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.keepawake">

    <!-- Berechtigung für WakeLock -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Berechtigung für Foreground Service (ab Android 9) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- Berechtigung für Benachrichtigungen -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KeepAwakeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeepAwake"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KeepAwake">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground Service für WakeLock -->
        <service
            android:name=".KeepAwakeService"
            android:foregroundServiceType="systemAlert"
            android:exported="false" />

        <!-- App Widget -->
        <receiver
            android:name=".KeepAwakeWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/keepawake_widget_info" />
        </receiver>

    </application>

</manifest>
